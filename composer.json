{
    "name": "fastd/http",
    "description": "FastD Http",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "FastD",
        "swoole",
        "psr7",
        "http-message",
        "http"
    ],
    "authors": [
        {
            "name": "janhuang",
            "email": "384099566@qq.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "*",
        "psr/http-client": "*",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "swoole/ide-helper": "@dev",
        "phpstan/phpstan": "^1.12.24"
    },
    "suggest": {
        "ext-swoole": "Required to use the SwooleTableSessionHandler in a Swoole runtime"
    },
    "autoload": {
        "psr-4": {
            "FastD\\Http\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swoole\\Http\\": "tests/swoole/http"
        }
    }
}
