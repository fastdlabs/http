{
    "name": "fastd/http",
    "description": "PSR-7, PSR-17 and PSR-18 HTTP message, factory and client component for FastD.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "FastD",
        "swoole",
        "psr7",
        "http-message",
        "http"
    ],
    "authors": [
        {
            "name": "janhuang",
            "email": "384099566@qq.com"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "psr/http-message": "^2.0",
        "psr/http-factory": "*",
        "psr/http-client": "*",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "swoole/ide-helper": "^6.0",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "ext-swoole": "Required to use the SwooleTableSessionHandler in a Swoole >= 6.0 runtime",
        "ext-redis": "Required to use RedisSessionHandler with ext-redis."
    },
    "autoload": {
        "psr-4": {
            "FastD\\Http\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Swoole\\Http\\": "tests/swoole/http"
        }
    }
}
