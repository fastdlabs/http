parameters:
	ignoreErrors:
		-
			message: '#^Deprecated in PHP 8\.4\: Parameter \#3 \$previous \(Throwable\) is implicitly nullable via default value null\.$#'
			identifier: parameter.implicitlyNullable
			count: 1
			path: src/Exception/RequestException.php

		-
			message: '#^Class FastD\\Http\\Exception\\ClientException constructor invoked with 4 parameters, 1\-3 required\.$#'
			identifier: arguments.count
			count: 2
			path: src/Request/Client.php

		-
			message: '#^Variable \$responseBody on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Request/Client.php

		-
			message: '#^Method FastD\\Http\\Request\\SwooleServerRequest\:\:fromSwoole\(\) should return FastD\\Http\\Request\\SwooleServerRequest but returns FastD\\Http\\Request\\ServerRequest\.$#'
			identifier: return.type
			count: 1
			path: src/Request/SwooleServerRequest.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Request/SwooleServerRequest.php

		-
			message: '#^PHPDoc tag @return with type string is incompatible with native type void\.$#'
			identifier: return.phpDocType
			count: 1
			path: src/Request/UploadedFile.php
